<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_TOBE" targetNamespace="https://example.org/khuyen-mai-tobe">
  <process id="Process_TOBE" name="TO-BE - Đăng ký nhận khuyến mãi có AI" isExecutable="false">
    <laneSet id="LaneSet_TOBE">
      <lane id="Lane_Customer" name="Khách hàng">
        <flowNodeRef>Start</flowNodeRef>
        <flowNodeRef>Submit</flowNodeRef>
        <flowNodeRef>Supplement</flowNodeRef>
        <flowNodeRef>Received</flowNodeRef>
        <flowNodeRef>EndSuccess</flowNodeRef>
      </lane>
      <lane id="Lane_System" name="Hệ thống">
        <flowNodeRef>Record</flowNodeRef>
        <flowNodeRef>Eligibility</flowNodeRef>
        <flowNodeRef>Eligible</flowNodeRef>
        <flowNodeRef>Issue</flowNodeRef>
        <flowNodeRef>Send</flowNodeRef>
      </lane>
      <lane id="Lane_AI" name="AI / Tự động hóa">
        <flowNodeRef>CheckInfo</flowNodeRef>
        <flowNodeRef>Valid</flowNodeRef>
        <flowNodeRef>Risk</flowNodeRef>
        <flowNodeRef>ReviewNeeded</flowNodeRef>
      </lane>
      <lane id="Lane_Marketing" name="Marketing">
        <flowNodeRef>ManualReview</flowNodeRef>
        <flowNodeRef>Approved</flowNodeRef>
      </lane>
      <lane id="Lane_CSKH" name="Chăm sóc khách hàng">
        <flowNodeRef>Request</flowNodeRef>
        <flowNodeRef>Reject</flowNodeRef>
        <flowNodeRef>EndReject</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start" name="Bắt đầu"/>
    <task id="Submit" name="Gửi đăng ký"/>
    <serviceTask id="Record" name="Ghi nhận đăng ký"/>
    <serviceTask id="CheckInfo" name="AI kiểm tra thông tin"/>
    <exclusiveGateway id="Valid" name="Thông tin hợp lệ?" gatewayDirection="Diverging"/>
    <sendTask id="Request" name="Yêu cầu bổ sung tự động"/>
    <task id="Supplement" name="Bổ sung thông tin"/>
    <serviceTask id="Eligibility" name="Tự động kiểm tra điều kiện"/>
    <exclusiveGateway id="Eligible" name="Đủ điều kiện?" gatewayDirection="Diverging"/>
    <serviceTask id="Risk" name="AI đánh giá bất thường"/>
    <exclusiveGateway id="ReviewNeeded" name="Cần xét duyệt?" gatewayDirection="Diverging"/>
    <userTask id="ManualReview" name="Marketing xét duyệt ngoại lệ"/>
    <exclusiveGateway id="Approved" name="Được phê duyệt?" gatewayDirection="Diverging"/>
    <serviceTask id="Issue" name="Tự động cấp mã"/>
    <sendTask id="Send" name="Tự động gửi mã khuyến mãi"/>
    <task id="Received" name="Nhận mã"/>
    <endEvent id="EndSuccess" name="Hoàn tất"/>
    <sendTask id="Reject" name="Thông báo từ chối tự động"/>
    <endEvent id="EndReject" name="Kết thúc từ chối"/>
    <sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Submit"/>
    <sequenceFlow id="Flow_02" sourceRef="Submit" targetRef="Record"/>
    <sequenceFlow id="Flow_03" sourceRef="Record" targetRef="CheckInfo"/>
    <sequenceFlow id="Flow_04" sourceRef="CheckInfo" targetRef="Valid"/>
    <sequenceFlow id="Flow_05" sourceRef="Valid" targetRef="Request" name="Không"/>
    <sequenceFlow id="Flow_06" sourceRef="Request" targetRef="Supplement"/>
    <sequenceFlow id="Flow_07" sourceRef="Supplement" targetRef="CheckInfo"/>
    <sequenceFlow id="Flow_08" sourceRef="Valid" targetRef="Eligibility" name="Có"/>
    <sequenceFlow id="Flow_09" sourceRef="Eligibility" targetRef="Eligible"/>
    <sequenceFlow id="Flow_10" sourceRef="Eligible" targetRef="Reject" name="Không"/>
    <sequenceFlow id="Flow_11" sourceRef="Eligible" targetRef="Risk" name="Có"/>
    <sequenceFlow id="Flow_12" sourceRef="Risk" targetRef="ReviewNeeded"/>
    <sequenceFlow id="Flow_13" sourceRef="ReviewNeeded" targetRef="Issue" name="Không"/>
    <sequenceFlow id="Flow_14" sourceRef="ReviewNeeded" targetRef="ManualReview" name="Có"/>
    <sequenceFlow id="Flow_15" sourceRef="ManualReview" targetRef="Approved"/>
    <sequenceFlow id="Flow_16" sourceRef="Approved" targetRef="Issue" name="Có"/>
    <sequenceFlow id="Flow_17" sourceRef="Approved" targetRef="Reject" name="Không"/>
    <sequenceFlow id="Flow_18" sourceRef="Issue" targetRef="Send"/>
    <sequenceFlow id="Flow_19" sourceRef="Send" targetRef="Received"/>
    <sequenceFlow id="Flow_20" sourceRef="Received" targetRef="EndSuccess"/>
    <sequenceFlow id="Flow_21" sourceRef="Reject" targetRef="EndReject"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_TOBE">
    <bpmndi:BPMNPlane id="Plane_TOBE" bpmnElement="Process_TOBE">
      <bpmndi:BPMNShape id="Shape_Lane_Customer" bpmnElement="Lane_Customer" isHorizontal="true">
